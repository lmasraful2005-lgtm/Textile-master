<script>

// MENU SYSTEM
const navButtons = document.querySelectorAll("nav button");

navButtons.forEach(button => {
  button.addEventListener("click", () => {

    navButtons.forEach(b => b.classList.remove("active"));
    button.classList.add("active");

    document.querySelectorAll(".page").forEach(page => {
      page.classList.remove("active");
    });

    document.getElementById(button.dataset.page)
      .classList.add("active");

    window.scrollTo({top: 0, behavior: "smooth"});
  });
});


// DYE CALCULATION
function dyeCalc() {

  const weight = Number(document.getElementById("fabric").value);
  const shade = Number(document.getElementById("shade").value);

  const result = document.getElementById("dyeResult");

  if (weight <= 0 || shade < 0) {
    result.hidden = false;
    result.textContent = "সঠিক Fabric Weight ও Shade লিখুন।";
    return;
  }

  const dye = weight * shade / 100;

  result.hidden = false;
  result.textContent =
    "Required Dye = " + dye.toFixed(3) + " kg";
}


// WATER CALCULATION
function waterCalc() {

  const weight = Number(document.getElementById("weight").value);
  const ml = Number(document.getElementById("ml").value);

  const result = document.getElementById("waterResult");

  if (weight <= 0 || ml <= 0) {
    result.hidden = false;
    result.textContent = "সঠিক Weight ও M:L Ratio লিখুন।";
    return;
  }

  const water = weight * ml;

  result.hidden = false;
  result.textContent =
    "Required Water = " + water.toFixed(2) + " Liter";
}


// MCQ ANSWER CHECK
function checkQuiz() {

  const answers = {
    q1: "a",
    q2: "b",
    q3: "c",
    q4: "a",
    q5: "b"
  };

  let score = 0;

  for (const q in answers) {

    const selected =
      document.querySelector('input[name="' + q + '"]:checked');

    if (selected && selected.value === answers[q]) {
      score++;
    }
  }

  const result = document.getElementById("quizResult");

  result.hidden = false;
  result.textContent =
    "Your Result: " + score + " / 5";
}

</script>

